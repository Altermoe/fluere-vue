{
  "name": "fluere-vue",
  "version": "0.0.1",
  "description": "FluereVue：Fluent Design 2 设计规范的 Vue3 实现",
  "keywords": [
    "component library",
    "fluere",
    "fluere-vue",
    "ui",
    "ui framework",
    "vue",
    "vue3"
  ],
  "homepage": "https://fluere-vue.nahida.website",
  "license": "MIT",
  "author": "夕云葛城",
  "repository": {
    "type": "git",
    "url": "https://github.com/Altermoe/fluere-vue"
  },
  "scripts": {
    "dev": "pnpm --filter @fluere-vue/docs dev",
    "docs:dev": "pnpm --filter @fluere-vue/docs dev",
    "docs:build": "pnpm --filter @fluere-vue/docs build",
    "docs:generate": "pnpm --filter @fluere-vue/docs generate",
    "docs:preview": "pnpm --filter @fluere-vue/docs preview",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --ignore-pattern .dsh --ignore-pattern packages/designs/generated --ignore-pattern packages/designs/data --ignore-pattern packages/icons/generated",
    "lint:fix": "oxlint --fix --ignore-pattern .dsh --ignore-pattern packages/designs/generated --ignore-pattern packages/designs/data --ignore-pattern packages/icons/generated",
    "lint:ssr": "bash scripts/lint-ssr.sh",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:check:scan": "node scripts/i18n-check.mjs --scan",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "version:check-tag": "node scripts/version.mjs check --tag",
    "lint:buildspec": "python3 scripts/lint-buildspec.py .onedev-buildspec.yml",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "tsc": "pnpm -r tsc",
    "check": "pnpm lint && pnpm format && pnpm tsc && pnpm i18n:check && pnpm version:check",
    "check:fix": "pnpm lint:fix && pnpm format:fix && pnpm tsc"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "^6.0.3",
    "vite": "8.1.5",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.27.0"
}
