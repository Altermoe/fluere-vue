{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "vue"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "style": "warn"
  },
  "rules": {
    // === 当前项目风格 - 覆盖配置 (override) ===
    "import/no-named-export": "off",
    "unicorn/prefer-export-from": "off",
    "no-duplicate-imports": "off", // 允许分开导入
    // 本仓统一用具名导出：单导出文件（locale 切片、Nuxt composable 等）不改为 default ——
    // Nuxt 的自动导入只识别具名导出，改 default 会直接断掉自动导入。故关闭该偏好规则。
    "import/prefer-default-export": "off",
    // 类型 / 接口有意紧邻其实现或使用处，不强求全部 export 沉到文件末尾。
    "import/exports-last": "off",
    "sort-imports": "off", // 由 oxfmt 接管
    "sort-keys": "off",
    "max-statements": "off",
    // 过度噪音的扁平 style 规则：改代码收益低、噪声大，统一弱化为 off。
    // no-magic-numbers 保留（warn），只是需用命名常量落地。
    "capitalized-comments": "off",
    "import/consistent-type-specifier-style": "off",
    "no-ternary": "off",
    "no-continue": "off",
    "no-magic-numbers": "off",
    "no-nested-ternary": "off",
    "func-style": "off",
    "id-length": "off",
    "prefer-destructuring": "off",
    "unicorn/no-null": "off",
    "unicorn/no-nested-ternary": "off",
    "import/group-exports": "off",

    // === Vue 最佳实践 - 正确性 (correctness) ===
    "vue/no-dupe-keys": "error",
    "vue/no-export-in-script-setup": "error",
    "vue/no-expose-after-await": "error",
    "vue/no-import-compiler-macros": "error",
    "vue/no-lifecycle-after-await": "error",
    "vue/no-multiple-slot-args": "error",
    "vue/no-reserved-keys": "error",
    "vue/no-reserved-props": "error",
    "vue/no-side-effects-in-computed-properties": "error",
    "vue/no-watch-after-await": "error",
    "vue/return-in-computed-property": "error",
    "vue/return-in-emits-validator": "error",
    "vue/valid-define-emits": "error",
    "vue/valid-define-options": "error",
    "vue/valid-define-props": "error",
    "vue/valid-next-tick": "error",
    "vue/no-async-in-computed-properties": "error",
    "vue/no-computed-properties-in-data": "error",
    "vue/no-shared-component-data": "error",
    "vue/require-render-return": "error",
    "vue/require-slots-as-functions": "error",

    // === Vue 最佳实践 - 可疑代码 (suspicious) ===
    "vue/no-arrow-functions-in-watch": "warn",
    "vue/no-required-prop-with-default": "warn",
    "vue/no-reserved-component-names": "warn",
    "vue/no-this-in-before-route-enter": "warn",
    "vue/prefer-import-from-vue": "warn",
    "vue/require-prop-type-constructor": "warn",

    // === Vue 最佳实践 - 风格 (style) ===
    "vue/component-definition-name-casing": ["warn", "PascalCase"],
    "vue/prop-name-casing": ["warn", "camelCase"],
    "vue/define-props-declaration": ["warn", "type-based"],
    "vue/define-emits-declaration": ["warn", "type-based"],
    "vue/define-props-destructuring": "off",
    "vue/next-tick-style": ["warn", "promise"],

    // === Vue 最佳实践 - 限制 (restriction) ===
    "vue/require-default-prop": "warn",
    "vue/require-prop-types": "warn",
    "vue/require-typed-ref": "warn",
    "vue/max-props": ["warn", { "maxProps": 30 }],

    // === Vue 3 弃用检测 ===
    "vue/no-deprecated-data-object-declaration": "warn",
    "vue/no-deprecated-delete-set": "warn",
    "vue/no-deprecated-destroyed-lifecycle": "warn",
    "vue/no-deprecated-events-api": "warn",
    "vue/no-deprecated-model-definition": "warn",
    "vue/no-deprecated-props-default-this": "warn",
    "vue/no-deprecated-vue-config-keycodes": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "vue": true
  },
  "overrides": [
    {
      // scripts/ 是仓库自用的 Node 脚本（无浏览器产物），用 node: 内建模块是其职责本身。
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    }
  ],
  "ignorePatterns": ["**/node_modules/", "**/dist/", "**/build/", "**/.eslintrc*", "*.config.*"]
}
