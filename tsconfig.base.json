{
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "**/.nuxt",
    "**/.output",
    "**/.data",
    "**/coverage",
    ".pnpm-store",
    "temp"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/tmp/tsconfig.tsbuildinfo",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@fluere-vue/themes": ["./packages/themes/src/index.ts"],
      "@fluere-vue/themes/*": ["./packages/themes/src/*"],
      "@fluere-vue/designs": ["./packages/designs/src/index.ts"],
      "@fluere-vue/designs/*": ["./packages/designs/src/*"],
      "@fluere-vue/ui": ["./packages/ui/src/index.ts"],
      "@fluere-vue/ui/*": ["./packages/ui/src/*"],
      "@fluere-vue/hooks": ["./packages/hooks/src/index.ts"],
      "@fluere-vue/hooks/*": ["./packages/hooks/src/*"],
      "@fluere-vue/utils": ["./packages/utils/src/index.ts"],
      "@fluere-vue/utils/*": ["./packages/utils/src/*"],
      "@fluere-vue/icons": ["./packages/icons/src/index.ts"],
      "@fluere-vue/icons/data": ["./packages/icons/generated/icons.json"],
      "@fluere-vue/icons/*": ["./packages/icons/src/*"]
    }
  }
}
