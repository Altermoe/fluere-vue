{
  "name": "@fluere-vue/utils",
  "version": "0.5.0-alpha.1",
  "description": "FluereVue 共享工具函数",
  "keywords": [
    "fluere",
    "fluere-vue",
    "utils",
    "vue"
  ],
  "license": "MIT",
  "author": "夕云葛城",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Altermoe/fluere-vue.git",
    "directory": "packages/utils"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "tsc": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
