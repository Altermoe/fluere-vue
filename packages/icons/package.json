{
  "name": "@fluere-vue/icons",
  "version": "0.0.1",
  "description": "WinUI 3 / Fluent System Icons 的 Vue3 图标库（生成自官方 @fluentui/svg-icons，MIT）",
  "keywords": [
    "fluent",
    "fluent-icons",
    "icons",
    "segoe",
    "vue",
    "vue3",
    "winui"
  ],
  "license": "MIT",
  "author": "夕云葛城",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Altermoe/fluere-vue.git",
    "directory": "packages/icons"
  },
  "files": [
    "dist",
    "generated",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data": "./generated/icons.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync": "node scripts/sync-icons.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
