# FluereVue 私有值示例（本文件入库，只放「不可达 / 非实际」的同格式示例）
#
# 公开文档（README 等）中以 ${VAR} 别名引用的基础设施值，真实值统一维护在根目录
# .env.local —— 它已被 .gitignore 忽略，禁止提交、禁止粘回任何公开文档。
# 变量名与 scripts/deploy.sh 的环境变量保持一致；CI 侧同名值放 OneDev 构建密钥。
# 仓库代码不会自动加载本文件；它是格式对照，用法：cp .env.example .env.local 后替换为真实值。

# CI 出网代理（宿主可达地址；`none` / 空值表示直连）。示例为 RFC 5737 保留地址，不可达。
CI_HTTP_PROXY=http://192.0.2.1:3128

# 生产 OneDev 远端仓库。示例为 RFC 2606 保留域名，不可达。
ONEDEV_REMOTE=https://git.example.com/fluere-vue.git

# 部署根目录（宿主机绝对路径；docker -v 按宿主解析）。
DEPLOY_ROOT=/srv/example-site

# 宿主监听地址:端口（只绑回环）。
DEPLOY_BIND=127.0.0.1:18080

# nginx 镜像（示例仅示格式，实际请 pin 具体 tag）。
NGINX_IMAGE=nginx:alpine

# 容器名。
DEPLOY_CONTAINER=example-web